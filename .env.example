# swedennu configuration — copy to .env and adjust before starting.

# Connection string the backend uses. Inside Docker the host is "postgres"
# (the compose service name); port 5432 is the container-internal port.
DATABASE_URL=postgres://swedennu:swedennu@postgres:5432/swedennu?sslmode=disable

# Port the Go backend listens on (also used by nginx proxy_pass).
PORT=3000

# Host port nginx (frontend) is published on.
FRONTEND_PORT=8091

# How often the sync loop re-fetches all upstream APIs. Go duration syntax.
# Keep >= 15m: polisen.se allows max 60 requests/hour.
SYNC_INTERVAL=15m

# Bearer token protecting POST /api/v1/sync and GET /api/v1/admin/stats.
# Empty = unprotected (dev only). Generate with: openssl rand -hex 32
SYNC_TOKEN=

# Trafikverket open data API key (free, register at https://api.trafikverket.se).
# Empty = traffic sync skipped.
TRAFIKVERKET_API_KEY=

# REQUIRED by polisen.se terms: contact email embedded in the User-Agent
# header so they can reach the operator. Syncs work without it, but set it.
CONTACT_EMAIL=you@example.com

# Directory for the access.log file. Empty = file logging disabled
# (requests are still logged to the access_log table).
LOG_DIR=

# Postgres container bootstrap credentials (used by the postgres service).
# NOTE: the password here must match the one in DATABASE_URL above.
# Change BOTH before production.
POSTGRES_DB=swedennu
POSTGRES_USER=swedennu
POSTGRES_PASSWORD=swedennu

# Set to "true" for debug-level logging.
DEBUG=false
